# ============================================================
# VigilNode — Environment Configuration
# ============================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in values below
# 3. Never commit .env to git (it's in .gitignore)
# ============================================================


# ------------------------------------------------------------
# REQUIRED — app will not start without these
# ------------------------------------------------------------

# A random secret string used to sign session cookies
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# Dashboard login credentials
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=


# ------------------------------------------------------------
# OPTIONAL — Telegram alerts
# ------------------------------------------------------------
# Leave blank to disable Telegram notifications.
#
# Setup:
#   1. Message @BotFather on Telegram → /newbot → copy the token
#   2. Message @userinfobot on Telegram → copy your chat ID
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ------------------------------------------------------------
# OPTIONAL — Alert thresholds (percent, defaults shown)
# ------------------------------------------------------------
CPU_ALERT_THRESHOLD=85
RAM_ALERT_THRESHOLD=90
DISK_ALERT_THRESHOLD=95
TEMP_ALERT_THRESHOLD=80


# ------------------------------------------------------------
# OPTIONAL — Security settings (defaults shown)
# ------------------------------------------------------------

# Brute-force detection: alert if this many failed SSH logins...
FAILED_LOGIN_THRESHOLD=5
# ...occur within this many seconds
FAILED_LOGIN_WINDOW=60

# Minimum seconds between repeat alerts for the same event
ALERT_COOLDOWN=600
