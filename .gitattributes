# Handle line endings automatically for all files
* text=auto

# Python files — always LF
*.py text eol=lf

# Shell scripts — always LF
*.sh text eol=lf

# Windows batch scripts — always CRLF
*.bat text eol=crlf

# Config and text files — always LF
*.md text eol=lf
*.txt text eol=lf
*.env text eol=lf
*.example text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cfg text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
